{
	"name": "demo-cookierun-encode",
	"type": "module",
	"private": true,
	"packageManager": "bun@1.4.2",
	"imports": {
		"#lib/*": "./src/lib/*.ts",
		"#components/*": "./src/components/*.ts",
		"#assets/*": "./assets/*"
	},
	"scripts": {
		"fetch:assets": "bun scripts/fetch-assets.ts",
		"verify:assets": "bun scripts/verify-assets.ts",
		"test": "bun test",
		"dev": "bun-server dev --statics 'assets/**/*.png'",
		"build": "bun-server build --statics 'assets/**/*.png'",
		"preview": "bun-server preview",
		"check": "bun run check:type && bun run check:biome",
		"check:biome": "biome check",
		"check:type": "tsc --noEmit",
		"format": "bun run format:biome",
		"format:biome": "biome check --write --unsafe",
		"deploy": "wrangler deploy"
	},
	"dependencies": {
		"@kcstyles/reset.css": "1.0.12",
		"@kctools/bun-server": "0.3.2",
		"lit": "3.3.3"
	},
	"devDependencies": {
		"@biomejs/biome": "2.5.13",
		"@happy-dom/global-registrator": "20.14.3",
		"@kcconfigs/biome": "2.0.4",
		"@kcconfigs/tsconfig": "1.1.5",
		"@types/bun": "1.4.2",
		"typescript-language-server": "6.0.0",
		"wrangler": "4.131.0"
	},
	"peerDependencies": {
		"typescript": "7.0.2"
	}
}
